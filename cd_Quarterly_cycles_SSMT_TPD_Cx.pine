    add_to_array(arr_chD,chmaxD[1])
    add_to_array(arr_clD,clminD[1])
    add_to_array(arr_coD,co0D[1])
    add_to_array(arr_ccD,cc0D[1]) 
 /////////////////////////////////////////////
