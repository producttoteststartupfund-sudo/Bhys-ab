 /////////////////////////////////////////////
var arr_chm = array.new_float()
var arr_clm = array.new_float()
var arr_com = array.new_float()
var arr_ccm = array.new_float()
var co0m = open 
var chmaxm = high
var clminm = low

if micro_tick
    co0m   := xo0
    chmaxm := xh0
    clminm := xl0
else
