/////////////////////////////////////
add_to_array(arr, value) =>
    array.unshift(arr, value)
    if array.size(arr) > num_candles -1
        array.pop(arr)
f_live_sym(_xc0,_xo0,_xh0,_xl0,_xt0,_tf)=>
    var _c1 = 0.0, var _o1 = 0.0 , var _h1 = 0.0, var _l1 = 0.0, var _t1 = 0
    var _c2 = 0.0, var _o2 = 0.0 , var _h2 = 0.0, var _l2 = 0.0, var _t2 = 0 
    var up0 = false , var up1 = false
    var dw0 = false , var dw1 = false
    var _l0t = time , var _h0t = time, var _h1t = time , var _l1t = time   
    var _o0 = open
    var _h0 = high
    var _l0 = low
    var _t0 = time
    var _c0 = close
    if timeframe.change(_tf)
        _t0 := _xt0
        _o0 := _xo0
        _h0 := _xh0
        _l0 := _xl0
        
    if _xh0 >= _h0
        _h0 := _xh0
        _h0t := time
    if _xl0 <= _l0
        _l0 := _xl0
        _l0t := time
    _c0 := _xc0
    up0 := _c0 > _o0
    dw0 := _c0 < _o0
    if timeframe.change(_tf)
        _c1  :=  _c0[1]
        _o1  :=  _o0[1]
        _h1  :=  _h0[1]
        _l1  :=  _l0[1]
        _t1  :=  _t0[1]
        _c2  :=  _c1[1]
        _o2  :=  _o1[1]
        _h2  :=  _h1[1]
        _l2  :=  _l1[1]
        _t2  :=  _t1[1] 
        up1  :=  up0[1]
        dw1  :=  dw0[1]
        _l1t :=  _l0t[1]
        _h1t :=  _h0t[1]
    [_h2,_l2,_c2,_o2,_t2,_h1,_l1,_c1,_o1,_t1,_h0,_l0,_c0,_o0,_t0,up1,dw1,_l1t,_h1t] 
f_text(string _tf)=>
    _text = str.tonumber(_tf) < 59 ? _tf + 'm'  :
     str.tonumber(_tf) > 59  ? 'h'+ str.tostring(math.floor(str.tonumber(_tf)/60))    : _tf
    _text := _tf == "1D" ? "D" : _tf == "1W" ? "W" : _tf == "1M" ? "M" : _text    
Getcolor_candle(_o,_c)=>
    clr = _c > _o ? bull_clr : _o > _c ? bear_clr : eq_clr
    clr
f_plot_candle(_c,_o,_h,_l,start,i,txt)=>
    dxx =dx
    nn = num_candles
    m = nn - i
    bl0=box.new(left=bar_index+start+dxx+ 0 + m * 3  ,top= _c , right= bar_index+start + dxx + 2 + m * 3 , bottom = _o  , bgcolor = Getcolor_candle(_o,_c), border_color = brd_clr , text = txt , text_size = i_font ,text_valign = text.align_center , text_halign = text.align_center ,text_color = color.white)
    wup=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _h , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.max(_o,_c)  , border_color = brd_clr,border_width =1)
    wdw=box.new(left=bar_index+start+dxx+ 1 + m * 3  ,top= _l , right= bar_index+start + dxx + 1 + m * 3 , bottom = math.min(_o,_c) , border_color = brd_clr,border_width =1)
    box.delete(bl0[1])
    box.delete(wup[1])    
    box.delete(wdw[1]) 
///////////////////////////////////////////
RemainingTime(_TF) =>
    if barstate.isrealtime
        timeRemaining = (_TF - timenow) / 1000
        days = math.floor(timeRemaining / 86400)
        hours = math.floor((timeRemaining - days * 86400) / 3600)
        minutes = math.floor((timeRemaining - days * 86400 - hours * 3600) / 60)
        seconds = math.floor(timeRemaining - days * 86400 - hours * 3600 - minutes * 60)

        r = str.tostring(seconds, '00')
        if minutes == 0
            r:= str.tostring(minutes, '00') + ':' + r
            r
        if minutes > 0 or hours > 0 or days > 0
            r := str.tostring(minutes, '00') + ':' + r
            r
        if hours > 0 or days > 0
            r := str.tostring(hours, '00') + ':' + r
            r
        if days > 0
            r := str.tostring(days) + 'D ' + r
            r
        r

    else
        'Market closed' 

var tablo3 = table.new(position = position.bottom_center,columns = 2,rows = 11,frame_color=color.new(color.teal,50),frame_width=2,border_color=color.new(color.teal,50),border_width=1)
if not str.contains(syminfo.tickerid,"replay")and show_rm
    table.cell(tablo3,0,0,text="TF: " + RemainingTime(time_close(tf)) ,text_color=color.white,bgcolor= #089981, text_size = i_font)

///////////////////////////////////
var TWO = open , var TDO = open, TSO = open , var TMSO = open
var TWOt = time, var TDOt = time, var TSOt = time, var TMSOt = time
var boxW = array.new_box()
var boxD = array.new_box()
var boxN = array.new_box()
var boxm = array.new_box()
var lblW = array.new_label()
var lblD = array.new_label()
var lblN = array.new_label()
var lblm = array.new_label()
get_range(session, session_name, session_css,show,nn)=>
    var t = 0 
    var max = high
    var min = low
    var box bx = na
    var label lbl = na 
    show_txt = show 
    if session > session[1]
        t := time
        max := high
        min := low
        bx := box.new(n, max, n, min
         , bgcolor = color.new(session_css, bg_transp)
         , border_color = show_outline ? session_css : na
         , border_style = line.style_dotted)
        if show_txt
            lbl := label.new(t, max, session_name
             , xloc = xloc.bar_time
             , textcolor = session_css
             , style = label.style_label_down
             , color = color.new(color.white, 100)
             , size = i_font )

        if nn==4 and show_last
            add_to_array(boxm,bx)
            add_to_array(lblm,lbl)            
        if nn==3 and show_last
            add_to_array(boxN,bx)
            add_to_array(lblN,lbl)            
        if nn==2 and show_last
            add_to_array(boxD,bx)
            add_to_array(lblD,lbl)            
        if nn==1 and show_last
            add_to_array(boxW,bx)
            add_to_array(lblW,lbl)           
    if session and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        box.set_top(bx, max)
        box.set_rightbottom(bx, n, min)
        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)

    if show_last and nn==4 and array.size(boxm) > num_cycle
        dbox = array.get(boxm,num_cycle)
        dlbl = array.get(lblm,num_cycle)
        array.remove(boxm,num_cycle)
        array.remove(lblm,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl) 
    if show_last and nn==3 and array.size(boxN) > num_cycle
        dbox = array.get(boxN,num_cycle)
        dlbl = array.get(lblN,num_cycle)
        array.remove(boxN,num_cycle)
        array.remove(lblN,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl) 
    if show_last and nn==2 and array.size(boxD) > num_cycle
        dbox = array.get(boxD,num_cycle)
        dlbl = array.get(lblD,num_cycle)
        array.remove(boxD,num_cycle)
        array.remove(lblD,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl)
    if show_last and nn==1 and array.size(boxW) > num_cycle
        dbox = array.get(boxW,num_cycle)
        dlbl = array.get(lblW,num_cycle)
        array.remove(boxW,num_cycle)
        array.remove(lblW,num_cycle)        
        box.delete(dbox)
        label.delete(dlbl)  
get_dfr(session, session_name, session_css,show,nn)=>
    var t = 0 
    var max = high
    var min = low
    var line bxh = na
    var line bxl = na
    var label lbl = na 
    var box dp1_ln = na, var box dp2_ln = na, var box dp2_5_ln = na, var box dp4_ln = na
    var box dn1_ln = na, var box dn2_ln = na, var box dn2_5_ln = na, var box dn4_ln = na

    show_txt = show
            
    if session > session[1]
        t := time
        max := high
        min := low
        bxh := line.new(t, max, t, max
         , xloc  = xloc.bar_time
         , color = session_css 
         , style = line.style_dotted
         , width =2 )
        bxl := line.new(t, min, t, min
         , xloc  = xloc.bar_time
         , color = session_css 
         , style = line.style_dotted
         , width = 2 ) 

        if show_txt
            lbl := label.new(t, max, session_name
             , xloc = xloc.bar_time
             , textcolor = session_css
             , style = label.style_label_down
             , color = color.new(color.white, 100)
             , size = i_font )


    if session and session == session[1]
        max := math.max(high, max)
        min := math.min(low, min)
        line.set_y1(bxh, max)
        line.set_y2(bxh, max)
        line.set_x2(bxh,time)
        line.set_y1(bxl, min)
        line.set_y2(bxl, min)
        line.set_x2(bxl,time)                       
        if show_txt 
            label.set_xy(lbl, int(math.avg(t, time)), max)
            
        dr  = max - min
        dp1 = max + dr , dp2 = max + 2 * dr , dp2_5 = max + 2.5 * dr , dp4 = max + 4 * dr       
        dn1 = min - dr , dn2 = min - 2 * dr , dn2_5 = min - 2.5 * dr , dn4 = min - 4 * dr
 
        dp1_ln := box.new(left= t , top = dp1, right = time, bottom = dp1 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "1", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp1_ln[1])
        dp2_ln := box.new(left= t , top = dp2, right = time, bottom = dp2 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "2", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp2_ln[1])
        dp2_5_ln := box.new(left= t , top = dp2_5, right = time, bottom = dp2_5 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "2.5", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp2_5_ln[1])
        dp4_ln := box.new(left= t , top = dp4, right = time, bottom = dp4 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "4", text_color = session_css,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dp4_ln[1])

        dn1_ln := box.new(left= t , top = dn1, right = time, bottom = dn1 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-1", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn1_ln[1])
        dn2_ln := box.new(left= t , top = dn2, right = time, bottom = dn2 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-2", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn2_ln[1])
        dn2_5_ln := box.new(left= t , top = dn2_5, right = time, bottom = dn2_5 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-2.5", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn2_5_ln[1])
        dn4_ln := box.new(left= t , top = dn4, right = time, bottom = dn4 , xloc=xloc.bar_time, 
         border_color = session_css,bgcolor = color.new(color.red,100),text = "-4", text_color = session_css,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
        box.delete(dn4_ln[1])

//////////////////////////////////////////////////////////////////////////////////////////
arrtfok   = array.from((show_candlesmic and tf_ok_mic), (show_candles30  and tf_ok30), (show_candles90  and tf_ok), (show_candlesD   and tf_okD), (show_candlesW   and tf_okW))          
arrstart  = array.from(0, 0, 0, 0, 0)
f_start()=>
    for i = 0 to 4
        array.set(arrstart,i,0)
    j = 0
    for i= 0 to 4
        if array.get(arrtfok,i) == true
            array.set(arrstart,i,j * 22)
            j := j + 1
//-----------------------------------------------------------------------------}
//Sessions
//-----------------------------------------------------------------------------{

var tz = str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

// 90m DFR anchors (unchanged)
dfra_txt = '' , dfra_css = dfr_clr, dfra = "", is_dfra = math.sign(nz(time(tf,'1830-1930' , tz))) ////90m dfr
dfre_txt = '' , dfre_css = dfr_clr, dfre = "", is_dfre = math.sign(nz(time(tf,'0030-0130' , tz))) 
dfri_txt = '' , dfri_css = dfr_clr, dfri = "", is_dfri = math.sign(nz(time(tf,'0630-0730' , tz))) 
dfrm_txt = '' , dfrm_css = dfr_clr, dfrm = "", is_dfrm = math.sign(nz(time(tf,'1230-1330' , tz)))

dfrq_txt = '' , dfrq_css = dfrD_clr, dfrq = "", is_dfrq = math.sign(nz(time(tf,'2000-0000' , tz))) ///daily dfr

dfrW_txt = '' , dfrW_css = dfrW_clr, dfrW = "", is_dfrW = math.sign(nz(time(tf,'0200-0000' , tz))) ///weekly dfr

// Daily cycle (updated)
// A: 18:00–02:30, M: 02:30–07:00, D: 07:00–11:30, R: 11:30–16:00, X: 16:00–18:00 (filler)
sesq_txt = 'Daily A' , sesq_css = daily_clr, txtq = "A", is_sesq = math.sign(nz(time(tf, '1800-0230', tz)))
sesr_txt = 'Daily M' , sesr_css = daily_clr, txtr = "M", is_sesr = math.sign(nz(time(tf, '0230-0700', tz)))
sess_txt = 'Daily D' , sess_css = daily_clr, txts = "D", is_sess = math.sign(nz(time(tf, '0700-1130', tz)))
sest_txt = 'Daily R' , sest_css = daily_clr, txtt = "R", is_sest = math.sign(nz(time(tf, '1130-1600', tz)))
sesx_txt = 'Daily X' , sesx_css = daily_clr, txtx = "X", is_sesx = math.sign(nz(time(tf, '1600-1800', tz)))

// 90m cycle re-anchored to Daily starts (A/M/D/R + filler X 16:00–18:00)
// A: 18:00–02:30 => 1800-1930,1930-2100,2100-2230,2230-0000,0000-0130,0130-0230
sesa_txt = 'A-1' , sesa_css = q1_clr, txta = "A", is_sesa = math.sign(nz(time(tf, '1800-1930', tz))) 
sesb_txt = 'A-2' , sesb_css = q2_clr, txtb = "A", is_sesb = math.sign(nz(time(tf, '1930-2100', tz))) 
sesc_txt = 'A-3' , sesc_css = q3_clr, txtc = "A", is_sesc = math.sign(nz(time(tf, '2100-2230', tz)))  
sesd_txt = 'A-4' , sesd_css = q4_clr, txtd = "A", is_sesd = math.sign(nz(time(tf, '2230-0000', tz))) 
sese_txt = 'A-5' , sese_css = q1_clr, txte = "A", is_sese = math.sign(nz(time(tf, '0000-0130', tz)))
sesf_txt = 'A-6' , sesf_css = q2_clr, txtf = "A", is_sesf = math.sign(nz(time(tf, '0130-0230', tz)))  
// M: 02:30–07:00 => 0230-0400,0400-0530,0530-0700
sesg_txt = 'M-1' , sesg_css = q3_clr, txtg = "M", is_sesg = math.sign(nz(time(tf, '0230-0400', tz))) 
sesh_txt = 'M-2' , sesh_css = q4_clr, txth = "M", is_sesh = math.sign(nz(time(tf, '0400-0530', tz))) 
sesi_txt = 'M-3' , sesi_css = q1_clr, txti = "M", is_sesi = math.sign(nz(time(tf, '0530-0700', tz)))  
// D: 07:00–11:30 => 0700-0830,0830-1000,1000-1130
sesj_txt = 'D-1' , sesj_css = q2_clr, txtj = "D", is_sesj = math.sign(nz(time(tf, '0700-0830', tz)))  
sesk_txt = 'D-2' , sesk_css = q3_clr, txtk = "D", is_sesk = math.sign(nz(time(tf, '0830-1000', tz)))  
sesl_txt = 'D-3' , sesl_css = q4_clr, txtl = "D", is_sesl = math.sign(nz(time(tf, '1000-1130', tz)))  
// R: 11:30–16:00 => 1130-1300,1300-1430,1430-1600
sesm_txt = 'R-1' , sesm_css = q1_clr, txtm = "R", is_sesm = math.sign(nz(time(tf, '1130-1300', tz))) 
sesn_txt = 'R-2' , sesn_css = q2_clr, txtn = "R", is_sesn = math.sign(nz(time(tf, '1300-1430', tz))) 
seso_txt = 'R-3' , seso_css = q3_clr, txto = "R", is_seso = math.sign(nz(time(tf, '1430-1600', tz))) 
// Filler X: 16:00–18:00 to keep 16 slots
sesp_txt = 'X'   , sesp_css = q4_clr, txtp = "X", is_sesp = math.sign(nz(time(tf, '1600-1800', tz))) 

//Weekly cycle
var trueday = 2
var newday = false
if is_sesq[1] == 0 and is_sesq == 1 and newday == false 
    trueday :=  
     day_week == 1 ? 2 :  
     day_week == 2 ? 3 :
     day_week == 3 ? 4 :
     day_week == 4 ? 5 :
     day_week == 5 ? 6 : 
     day_week == 6 ? 7 : 1 //
    newday := true
if (is_sesq[1] == 1 and is_sesq == 1)   
    newday := false

is_week1 = trueday  == 2 ? 1 : 0//monday
is_week2 = trueday  == 3 ? 1 : 0
is_week3 = trueday  == 4 ? 1 : 0
is_week4 = trueday  == 5 ? 1 : 0
is_week5 = trueday  == 6 ? 1 : 0
is_week6 = trueday  == 7 ? 1 : 0
is_week7 = trueday  == 1 ? 1 : 0//sunday
//-----------------------------------------------------------------------------}
//Overlays
//-----------------------------------------------------------------------------{
//Ranges
// Micro cycle boxes previously enumerated are intentionally omitted to prevent object overrun with 10m buckets.

if show_cycles90 and tf_ok 
    get_range(is_sesa, sesa_txt, sesa_css, show_labels90,3)
    get_range(is_sesb, sesb_txt, sesb_css, show_labels90,3)
    get_range(is_sesc, sesc_txt, sesc_css, show_labels90,3)
    get_range(is_sesd, sesd_txt, sesd_css, show_labels90,3)
    get_range(is_sese, sese_txt, sese_css, show_labels90,3)
    get_range(is_sesf, sesf_txt, sesf_css, show_labels90,3)
    get_range(is_sesg, sesg_txt, sesg_css, show_labels90,3)
    get_range(is_sesh, sesh_txt, sesh_css, show_labels90,3)
    get_range(is_sesi, sesi_txt, sesi_css, show_labels90,3)
    get_range(is_sesj, sesj_txt, sesj_css, show_labels90,3)
    get_range(is_sesk, sesk_txt, sesk_css, show_labels90,3)
    get_range(is_sesl, sesl_txt, sesl_css, show_labels90,3)
    get_range(is_sesm, sesm_txt, sesm_css, show_labels90,3)
    get_range(is_sesn, sesn_txt, sesn_css, show_labels90,3)
    get_range(is_seso, seso_txt, seso_css, show_labels90,3)
    get_range(is_sesp, sesp_txt, sesp_css, show_labels90,3)

if show_dfr and tf_ok
    get_dfr(is_dfra, dfra_txt, dfra_css, show_dfr,3)
    get_dfr(is_dfre, dfre_txt, dfre_css, show_dfr,3)
    get_dfr(is_dfri, dfri_txt, dfri_css, show_dfr,3)
    get_dfr(is_dfrm, dfrm_txt, dfrm_css, show_dfr,3)            
////daily cycle
if show_cyclesD and tf_okD
    get_range(is_sesq, sesq_txt, daily_clr, show_labelsD,2)
    get_range(is_sesr, sesr_txt, daily_clr, show_labelsD,2)
    get_range(is_sess, sess_txt, daily_clr, show_labelsD,2)
    get_range(is_sest, sest_txt, daily_clr, show_labelsD,2)
if show_dfrD and tf_okD
    get_dfr(is_dfrq, dfrq_txt, dfrq_css, show_dfrD,2)

if show_dfrW and tf_okW and is_week1
    get_dfr(is_dfrW, dfrW_txt, dfrW_css, show_dfrW,1)
  
/////weekly cycle
if show_cyclesW and tf_okW 
    get_range(is_week1, "Weekly A -Monday-", weekly_clr, show_labelsW,1)    
    get_range(is_week2, "Weekly M -Tueday-", weekly_clr, show_labelsW,1)
    get_range(is_week3, "Weekly D -Wednesday-", weekly_clr, show_labelsW,1)
    get_range(is_week4, "Weekly R -Thursday-", weekly_clr, show_labelsW,1)
    get_range(is_week5, "Weekly x -Friday-", color.new(weekly_clr,50), show_labelsW,1)
    if tipo == "crypto"
        get_range(is_week6, "Weekly x -Saturday-", color.new(weekly_clr,50), show_labelsW,1)  
        get_range(is_week7, "Weekly x -Sunday-", color.new(weekly_clr,50), show_labelsW,1)       
//////////////////////////////////////////// SMT begin

var o0 = open 
var hmax = high
var lmin = low
var t0 = time
var t1 = time
var txt0 = ""
var hmax_t = time
var lmin_t = time

var o030 = open 
var hmax30 = high
var lmin30 = low
var t030 = time
var t130 = time
var txt030 = ""

var o0D = open 
var hmaxD = high
var lminD = low
var t0D = time
var t1D = time
var txt0D = ""

var o0W = open 
var hmaxW = high
var lminW = low
var t0W = time
var t1W = time
var txt0W = ""

var o0m = open 
var hmaxm = high
var lminm = low
var t0m = time
var t1m = time
var txt0m = ""
var int micro_idx = 0
var bool newm = false

// 90m arrays/labels
arr_ses   = array.from(is_sesa,is_sesb,is_sesc,is_sesd,is_sese,is_sesf,is_sesg,is_sesh,is_sesi,is_sesj,is_sesk,is_sesl,is_sesm,is_sesn,is_seso,is_sesp)
arr_sesy  = array.from(txta,txtb,txtc,txtd,txte,txtf,txtg,txth,txti,txtj,txtk,txtl,txtm,txtn,txto,txtp)
arr_sesz  = array.from(sesa_txt,sesb_txt,sesc_txt,sesd_txt,sese_txt,sesf_txt,sesg_txt,sesh_txt,sesi_txt,sesj_txt,sesk_txt,sesl_txt,sesm_txt,sesn_txt,seso_txt,sesp_txt) 
val_ses   = array.indexof(arr_ses , 1) 

// Daily arrays/labels
arr_sesD  = array.from(is_sesq,is_sesr,is_sess,is_sest,is_sesx)
arr_sesDy = array.from(txtq,txtr,txts,txtt,txtx)
arr_sesDz = array.from(sesq_txt,sesr_txt,sess_txt,sest_txt,sesx_txt)
val_sesD  = array.indexof(arr_sesD,1)

// Weekly arrays/labels
arr_sesW  = array.from(is_week1,is_week2,is_week3,is_week4,is_week5,is_week6,is_week7)
arr_sesWy = array.from("A","M","D","R","Fr","Sat","Sun")
arr_sesWz = array.from("Weekly A","Weekly B","Weekly C","Weekly D","Weekly x","Weekly x","Weekly x")
val_sesW  = array.indexof(arr_sesW,1)

newW = val_sesW != val_sesW[1]
newD = val_sesD != val_sesD[1]
newN = val_ses  !=  val_ses[1]

// Start positions for columns
f_start()
cycle_highs = array.from(array.max(arr_hW),array.max(arr_hD),array.max(arr_h),array.max(arr_hm),array.max(arr_h30))
labels_high = array.max(cycle_highs)

//////////////////////////////////////////////// 90m candles
if tf_ok
    if val_ses != val_ses[1]
        o0 := open
        hmax := high
        lmin := low
        t0 := time

    if val_ses == val_ses[1]
        if high > hmax
            hmax := high
        if low < lmin
            lmin := low
    c0 = close
    txt0 := array.get(arr_sesy,val_ses)
    txtz = array.get(arr_sesz,val_ses)
    if val_ses != val_ses[1]
        add_to_array(arr_h,hmax[1])//hmax1
        add_to_array(arr_l,lmin[1])        
        add_to_array(arr_o,o0[1])
        add_to_array(arr_c,close[1])
        add_to_array(arr_t,txt0[1])
        t1 := t0[1]

    dt  =  t0 +(t0 - t1) 
    rmt  = RemainingTime(dt)
    rmttxt=  not str.contains(syminfo.tickerid,"replay") ? rmt : "replay mode"
    st90 = array.get(arrstart,2)
    if show_candles90 and tf_ok   
        f_plot_candle(c0,o0,hmax,lmin,st90,0,txt0)
    if array.size(arr_h) == num_candles-1 and show_candles90 and tf_ok
        f_plot_candle(array.get(arr_c,0 ),array.get(arr_o,0 ),array.get(arr_h,0 ),array.get(arr_l,0 ),st90,1,array.get(arr_t,0 ))
        f_plot_candle(array.get(arr_c,1 ),array.get(arr_o,1 ),array.get(arr_h,1 ),array.get(arr_l,1 ),st90,2,array.get(arr_t,1 ))
        f_plot_candle(array.get(arr_c,2 ),array.get(arr_o,2 ),array.get(arr_h,2 ),array.get(arr_l,2 ),st90,3,array.get(arr_t,2 ))
        f_plot_candle(array.get(arr_c,3 ),array.get(arr_o,3 ),array.get(arr_h,3 ),array.get(arr_l,3 ),st90,4,array.get(arr_t,3 ))
        f_plot_candle(array.get(arr_c,4 ),array.get(arr_o,4 ),array.get(arr_h,4 ),array.get(arr_l,4 ),st90,5,array.get(arr_t,4 ))
        lbl0 = label.new(bar_index+dx+st90+12,labels_high + 6 * ta.atr(20)  , text= "90m cycle"+'\n'+str.tostring(txtz)+'\n'+str.tostring(rmttxt),xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=i_font)
        label.delete(lbl0[1])

//////////////////////////////////////////////// 30m candles (anchored to A/M/D/R)
thirty_in   = is_sesq or is_sesr or is_sess or is_sest
thirty_tick = tf_ok30 and thirty_in and timeframe.change("30")
txt030      := is_sesq ? "A" : is_sesr ? "M" : is_sess ? "D" : is_sest ? "R" : "X"
if tf_ok30
    if thirty_tick
        o030   := open
        hmax30 := high
        lmin30 := low
        t030   := time
        // finalize previous
        add_to_array(arr_h30,hmax30[1])
        add_to_array(arr_l30,lmin30[1])        
        add_to_array(arr_o30,o030[1])
        add_to_array(arr_c30,close[1])
        add_to_array(arr_t30,txt030[1])
        t130 := t030[1]
    else
        if high > hmax30
            hmax30 := high
        if low < lmin30
            lmin30 := low

    c030   = close
    dt30   = t030 + (t030 - t130)
    rmt30  = RemainingTime(dt30)
    rmttxt30= not str.contains(syminfo.tickerid,"replay") ? rmt30 : "replay mode"
    st30   = array.get(arrstart,1)

    if show_candles30 and tf_ok30
        f_plot_candle(c030,o030,hmax30,lmin30,st30,0,txt030)
    if array.size(arr_h30) == num_candles-1 and show_candles30 and tf_ok30
        f_plot_candle(array.get(arr_c30,0 ),array.get(arr_o30,0 ),array.get(arr_h30,0 ),array.get(arr_l30,0 ),st30,1,array.get(arr_t30,0 ))
        f_plot_candle(array.get(arr_c30,1 ),array.get(arr_o30,1 ),array.get(arr_h30,1 ),array.get(arr_l30,1 ),st30,2,array.get(arr_t30,1 ))
        f_plot_candle(array.get(arr_c30,2 ),array.get(arr_o30,2 ),array.get(arr_h30,2 ),array.get(arr_l30,2 ),st30,3,array.get(arr_t30,2 ))
        f_plot_candle(array.get(arr_c30,3 ),array.get(arr_o30,3 ),array.get(arr_h30,3 ),array.get(arr_l30,3 ),st30,4,array.get(arr_t30,3 ))
        f_plot_candle(array.get(arr_c30,4 ),array.get(arr_o30,4 ),array.get(arr_h30,4 ),array.get(arr_l30,4 ),st30,5,array.get(arr_t30,4 ))
        lbl30 = label.new(bar_index+dx+st30+12,labels_high + 6 * ta.atr(20), text= "30m cycle"+'\n'+txt030+'\n'+rmttxt30,xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=i_font)
        label.delete(lbl30[1])

/////////////////////////////////////////////////////////////////////// daily cycle candles
if tf_okD
    if val_sesD != val_sesD[1]
        o0D   := open
        hmaxD := high
        lminD := low
        t0D   := time
    if val_sesD == val_sesD[1]
        if high > hmaxD
            hmaxD := high
        if low < lminD
            lminD := low
    c0D = close
    txt0D := array.get(arr_sesDy,val_sesD)
    txtzD = array.get(arr_sesDz,val_sesD)
    if val_sesD != val_sesD[1]
        add_to_array(arr_hD,hmaxD[1])
        add_to_array(arr_lD,lminD[1])        
        add_to_array(arr_oD,o0D[1])
        add_to_array(arr_cD,close[1])
        add_to_array(arr_tD,txt0D[1]) 
        t1D := t0D[1]
    if newD and txt0D == "M" and txt0D[1] == "A"
        TDO := o0D 
        TDOt:= time       
    dtD  =  t0D +(t0D - t1D) 
    rmtD  = RemainingTime(dtD)
    rmttxtD=  not str.contains(syminfo.tickerid,"replay") ? rmtD : "replay mode"
    stD = array.get(arrstart,3)
    if show_candlesD  and tf_okD  
        f_plot_candle(c0D,o0D,hmaxD,lminD,stD,0,txt0D)
    if array.size(arr_hD) == num_candles-1 and show_candlesD and tf_okD
        f_plot_candle(array.get(arr_cD,0 ),array.get(arr_oD,0 ),array.get(arr_hD,0 ),array.get(arr_lD,0 ),stD,1,array.get(arr_tD,0 ))
        f_plot_candle(array.get(arr_cD,1 ),array.get(arr_oD,1 ),array.get(arr_hD,1 ),array.get(arr_lD,1 ),stD,2,array.get(arr_tD,1 ))
        f_plot_candle(array.get(arr_cD,2 ),array.get(arr_oD,2 ),array.get(arr_hD,2 ),array.get(arr_lD,2 ),stD,3,array.get(arr_tD,2 ))
        f_plot_candle(array.get(arr_cD,3 ),array.get(arr_oD,3 ),array.get(arr_hD,3 ),array.get(arr_lD,3 ),stD,4,array.get(arr_tD,3 ))
        f_plot_candle(array.get(arr_cD,4 ),array.get(arr_oD,4 ),array.get(arr_hD,4 ),array.get(arr_lD,4 ),stD,5,array.get(arr_tD,4 ))
        lbl1 = label.new(bar_index+dx+stD+12,labels_high + 6 * ta.atr(20)  , text= "Daily cycle"+'\n'+str.tostring(txtzD)+'\n'+str.tostring(rmttxtD),xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=i_font)
        label.delete(lbl1[1])

//////////////////////////////////weekly cycle

if tf_okW 
    if val_sesW != val_sesW[1]
        o0W   := open
        hmaxW := high
        lminW := low
        t0W   := time
    if val_sesW == val_sesW[1]
        if high > hmaxW
            hmaxW := high
        if low < lminW
            lminW := low
    c0W = close
    txt0W := array.get(arr_sesWy,val_sesW)
    txtzW = array.get(arr_sesWz,val_sesW)
    if val_sesW != val_sesW[1]
        add_to_array(arr_hW,hmaxW[1])
        add_to_array(arr_lW,lminW[1])        
        add_to_array(arr_oW,o0W[1])
        add_to_array(arr_cW,close[1])
        add_to_array(arr_tW,txt0W[1]) 
        t1W := t0W[1]
    if newW and txt0W == "M" and txt0W[1] == "A"
        TWO  := o0W
        TWOt := time       
    dtW  =  t0W +(t0W - t1W) 
    rmtW  = RemainingTime(dtW)
    rmttxtW=  not str.contains(syminfo.tickerid,"replay") ? rmtW : "replay mode"
    stW = array.get(arrstart,4)
    if show_candlesW and tf_okW   
        f_plot_candle(c0W,o0W,hmaxW,lminW,stW,0,txt0W)
    if array.size(arr_hW) == num_candles-1 and show_candlesW and tf_okW 
        f_plot_candle(array.get(arr_cW,0 ),array.get(arr_oW,0 ),array.get(arr_hW,0 ),array.get(arr_lW,0 ),stW,1,array.get(arr_tW,0 ))
        f_plot_candle(array.get(arr_cW,1 ),array.get(arr_oW,1 ),array.get(arr_hW,1 ),array.get(arr_lW,1 ),stW,2,array.get(arr_tW,1 ))
        f_plot_candle(array.get(arr_cW,2 ),array.get(arr_oW,2 ),array.get(arr_hW,2 ),array.get(arr_lW,2 ),stW,3,array.get(arr_tW,2 ))
        f_plot_candle(array.get(arr_cW,3 ),array.get(arr_oW,3 ),array.get(arr_hW,3 ),array.get(arr_lW,3 ),stW,4,array.get(arr_tW,3 ))
        f_plot_candle(array.get(arr_cW,4 ),array.get(arr_oW,4 ),array.get(arr_hW,4 ),array.get(arr_lW,4 ),stW,5,array.get(arr_tW,4 ))
        lbl2 = label.new(bar_index+dx+stW+12,labels_high + 6 * ta.atr(20)  , text= "Weekly cycle"+'\n'+str.tostring(txtzW)+'\n'+str.tostring(rmttxtW),xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=i_font)
        label.delete(lbl2[1])

//////////////////////////////////Micro cycle (10-minute buckets aligned to A/M/D/R)
micro_in = is_sesq or is_sesr or is_sess or is_sest
micro_part = is_sesq ? "A" : is_sesr ? "M" : is_sess ? "D" : is_sest ? "R" : "X"
micro_tick = tf_ok_mic and micro_in and timeframe.change("10")

if tf_ok_mic
    if micro_tick
        o0m   := open
        hmaxm := high
        lminm := low
        t0m   := time
        // finalize previous
        add_to_array(arr_hm,hmaxm[1])
        add_to_array(arr_lm,lminm[1])        
        add_to_array(arr_om,o0m[1])
        add_to_array(arr_cm,close[1])
        add_to_array(arr_tm,micro_part[1]) 
        t1m := t0m[1]
        micro_idx += 1
    else
        if high > hmaxm
            hmaxm := high
        if low < lminm
            lminm := low

    c0m = close
    txt0m := micro_part
    txtzm = "Micro "+micro_part

    dtm  =  t0m +(t0m - t1m) 
    rmtm  = RemainingTime(dtm)
    rmttxtm=  not str.contains(syminfo.tickerid,"replay") ? rmtm : "replay mode"
    stm = array.get(arrstart,0)
    if show_candlesmic and tf_ok_mic   
        f_plot_candle(c0m,o0m,hmaxm,lminm,stm,0,txt0m)
    if array.size(arr_hm) == num_candles-1 and show_candlesmic and tf_ok_mic
        f_plot_candle(array.get(arr_cm,0 ),array.get(arr_om,0 ),array.get(arr_hm,0 ),array.get(arr_lm,0 ),stm,1,array.get(arr_tm,0 ))
        f_plot_candle(array.get(arr_cm,1 ),array.get(arr_om,1 ),array.get(arr_hm,1 ),array.get(arr_lm,1 ),stm,2,array.get(arr_tm,1 ))
        f_plot_candle(array.get(arr_cm,2 ),array.get(arr_om,2 ),array.get(arr_hm,2 ),array.get(arr_lm,2 ),stm,3,array.get(arr_tm,2 ))
        f_plot_candle(array.get(arr_cm,3 ),array.get(arr_om,3 ),array.get(arr_hm,3 ),array.get(arr_lm,3 ),stm,4,array.get(arr_tm,3 ))
        f_plot_candle(array.get(arr_cm,4 ),array.get(arr_om,4 ),array.get(arr_hm,4 ),array.get(arr_lm,4 ),stm,5,array.get(arr_tm,4 ))
        lbl3 = label.new(bar_index+dx+stm+12,labels_high + 6 * ta.atr(20)  , text= "Micro cycle"+'\n'+str.tostring(txtzm)+'\n'+str.tostring(rmttxtm),xloc=xloc.bar_index,color=color.new(color.teal,0),style=label.style_label_center,textcolor = color.white,size=i_font)
        label.delete(lbl3[1])

//////////////////////////////////////////// SMT 
csym   = sym
csym  := str.contains(sym,s1) and ok1 ? s2 : str.contains(sym,s2)and ok2 ? s1 : csym
csym  := str.contains(sym,s3) and ok2 ? s4 : str.contains(sym,s4)and ok2 ? s3 : csym
csym  := str.contains(sym,s5) and ok3 ? s6 : str.contains(sym,s6)and ok3 ? s5 : csym
csym  := str.contains(sym,s7) and ok4 ? s8 : str.contains(sym,s8)and ok4 ? s7 : csym 
csym  := syminfo.type == "futures" ? (ticker.modify(csym,session = syminfo.session,backadjustment=badj ? backadjustment.on:backadjustment.off) ) :csym //new

par_ok = csym != sym
[xc0,xo0,xh0,xl0,xt0]=request.security(csym,tf,[close,open,high,low,time],lookahead = barmerge.lookahead_on,ignore_invalid_symbol = true)
ssmt_pair  = str.tostring(syminfo.ticker(csym)) 
ssmt_label = 'SSMT --> '+ ssmt_pair +'\n'
ssmt_label := ssmt_label + dot_line + '\n'
////////////////////////////////////////////////////90m cycle high/low 
var arr_ch = array.new_float()
var arr_cl = array.new_float()
var arr_co = array.new_float()
var arr_cc = array.new_float()
var arr_h_t = array.new_int()
var arr_l_t = array.new_int()
var arr_ch_t = array.new_int()
var arr_cl_t = array.new_int()
var co0 = open 
var chmax = high
var clmin = low
var chmaxt = time
var clmint = time

if val_ses != val_ses[1]
    co0   := xo0
    chmax := xh0
    clmin := xl0
    chmaxt := xt0
    clmint := xt0
if val_ses == val_ses[1]
    if xh0 > chmax
        chmax := xh0
        chmaxt := xt0
    if xl0 < clmin
        clmin := xl0
        clmint := xt0
cc0 = xc0
if val_ses != val_ses[1]
    add_to_array(arr_ch,chmax[1])
    add_to_array(arr_cl,clmin[1])
    add_to_array(arr_co,co0[1])
    add_to_array(arr_cc,cc0[1])     
    add_to_array(arr_ch_t, chmaxt[1])
    add_to_array(arr_cl_t, clmint[1])
/////////////////////////////////////////////daily
