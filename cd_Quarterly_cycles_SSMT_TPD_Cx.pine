/////////////////////////////////////////////////////////////////////////////SMT 
f_ssmt(ah2,ah1,ah0,al2,al1,al0,bh2,bh1,bh0,bl2,bl1,bl0,start,show)=>
    _bear1 = ((ah2 > ah1 and bh2 <= bh1) or (ah2 <= ah1 and bh2 > bh1) ) and not(ah2 == ah1 and bh2 == bh1) 
    _bear0 = ((ah1 > ah0 and bh1 <= bh0) or (ah1 <= ah0 and bh1 > bh0) ) and not(ah1 == ah0 and bh1 == bh0) 
    _bull1 = ((al2 < al1 and bl2 >= bl1) or (al2 >= al1 and bl2 < bl1) ) and not(al2 == al1 and bl2 == bl1) 
    _bull0 = ((al1 < al0 and bl1 >= bl0) or (al1 >= al0 and bl1 < bl0) ) and not(al1 == al0 and bl1 == bl0)
    var smth1 = line.new(na,na,na,na)
    var smth0 = line.new(na,na,na,na)
    var smtl1 = line.new(na,na,na,na)
    var smtl0 = line.new(na,na,na,na)
    line.delete(smth1)
    line.delete(smth0)
    line.delete(smtl1)
    line.delete(smtl0)

    if _bear1 and show
        smth1 := line.new(bar_index+start+dx+13,ah2,bar_index+start+dx+16,ah1,color=smt_clr,width = 2)
    if _bear0 and show
        smth0 := line.new(bar_index+start+dx+16,ah1,bar_index+start+dx+19,ah0,color=smt_clr,width = 2)
    if _bull1 and show
        smtl1 := line.new(bar_index+start+dx+13,al2,bar_index+start+dx+16,al1,color=smt_clr,width = 2)
    if _bull0 and show
        smtl0 := line.new(bar_index+start+dx+16,al1,bar_index+start+dx+19,al0,color=smt_clr,width = 2)
    [_bear1,_bear0,_bull1,_bull0]
////////////////////////////////////////////////////////////////
W_SSMT = array.from(false,false,false,false)
D_SSMT = array.from(false,false,false,false)
N_SSMT = array.from(false,false,false,false)
m_SSMT = array.from(false,false,false,false)
if array.size(arr_hW) > 1 and array.size(arr_chW) > 1 and tf_okW 
    [bear1W,bear0W,bull1W,bull0W] = f_ssmt(array.get(arr_hW,1),array.get(arr_hW,0),hmaxW,array.get(arr_lW,1),array.get(arr_lW,0),lminW,
     array.get(arr_chW,1),array.get(arr_chW,0),chmaxW,array.get(arr_clW,1),array.get(arr_clW,0),clminW,array.get(arrstart,4),show_candlesW)//
    ssmt_label := bear1W ? ssmt_label + "Prev. Weekly Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull1W ? ssmt_label + "Prev. Weekly Cycles Bullish SSMT" + '\n' : ssmt_label
    ssmt_label := bear0W ? ssmt_label + "Live Weekly Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull0W ? ssmt_label + "Live Weekly Cycles Bullish SSMT" + '\n' : ssmt_label
    array.set(W_SSMT,0,bear1W)
    array.set(W_SSMT,1,bear0W)    
    array.set(W_SSMT,2,bull1W)
    array.set(W_SSMT,3,bull0W) 

if array.size(arr_hD) > 1 and array.size(arr_chD) > 1 and tf_okD
    [bear1D,bear0D,bull1D,bull0D] = f_ssmt(array.get(arr_hD,1),array.get(arr_hD,0),hmaxD,array.get(arr_lD,1),array.get(arr_lD,0),lminD,
     array.get(arr_chD,1),array.get(arr_chD,0),chmaxD,array.get(arr_clD,1),array.get(arr_clD,0),clminD,array.get(arrstart,3),show_candlesD)//
    ssmt_label := bear1D ? ssmt_label + "Prev. Daily Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull1D ? ssmt_label + "Prev. Daily Cycles Bullish SSMT" + '\n' : ssmt_label
    ssmt_label := bear0D ? ssmt_label + "Live Daily Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull0D ? ssmt_label + "Live Daily Cycles Bullish SSMT" + '\n' : ssmt_label
    array.set(D_SSMT,0,bear1D)
    array.set(D_SSMT,1,bear0D)    
    array.set(D_SSMT,2,bull1D)
    array.set(D_SSMT,3,bull0D)

if array.size(arr_h) > 1 and array.size(arr_ch) > 1 and tf_ok
    [bear1,bear0,bull1,bull0] = f_ssmt(array.get(arr_h,1),array.get(arr_h,0),hmax,array.get(arr_l,1),array.get(arr_l,0),lmin,
     array.get(arr_ch,1),array.get(arr_ch,0),chmax,array.get(arr_cl,1),array.get(arr_cl,0),clmin,array.get(arrstart,2),show_candles90)//
    ssmt_label := bear1 ? ssmt_label + "Prev. 90m Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull1 ? ssmt_label + "Prev. 90m Cycles Bullish SSMT" + '\n' : ssmt_label
    ssmt_label := bear0 ? ssmt_label + "Live 90m Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull0 ? ssmt_label + "Live 90m Cycles Bullish SSMT" + '\n' : ssmt_label
    array.set(N_SSMT,0,bear1)
    array.set(N_SSMT,1,bear0)    
    array.set(N_SSMT,2,bull1)
    array.set(N_SSMT,3,bull0)
    // draw on-chart SMT lines when enabled (use bar_time coordinates)
    if show_smt90_chart
        var line ln_bear1 = na
        var line ln_bear0 = na
        var line ln_bull1 = na
        var line ln_bull0 = na
        // previous segment SMTs
        lstyle = smt_line_style == "Solid" ? line.style_solid : smt_line_style == "Dashed" ? line.style_dashed : line.style_dotted
        // Optional candle direction validation
        bear_ok_prev = not smt_candle_check or (high[1] >= high[2] and high >= high[1])
        bull_ok_prev = not smt_candle_check or (low[1] <= low[2] and low <= low[1])
        if bear1 and array.size(arr_h_t) > 1 and array.size(arr_ch_t) > 1 and bear_ok_prev
            ln_bear1 := line.new(array.get(arr_h_t,1), array.get(arr_h,1), array.get(arr_h_t,0), array.get(arr_h,0), xloc = xloc.bar_time, extend=extend.none, color=smt_bear_color, width=smt_line_width, style=lstyle)
            if show_smt_labels
                label.new(array.get(arr_h_t,0), array.get(arr_h,0), "SMT", xloc=xloc.bar_time, style=label.style_label_down, textcolor=smt_label_color, color=color.new(color.white,100), size=smt_label_size)
        if bull1 and array.size(arr_l_t) > 1 and array.size(arr_cl_t) > 1 and bull_ok_prev
            ln_bull1 := line.new(array.get(arr_l_t,1), array.get(arr_l,1), array.get(arr_l_t,0), array.get(arr_l,0), xloc = xloc.bar_time, extend=extend.none, color=smt_bull_color, width=smt_line_width, style=lstyle)
            if show_smt_labels
                label.new(array.get(arr_l_t,0), array.get(arr_l,0), "SMT", xloc=xloc.bar_time, style=label.style_label_up, textcolor=smt_label_color, color=color.new(color.white,100), size=smt_label_size)
        // live segment SMTs
        bear_ok_live = not smt_candle_check or (close < open)
        bull_ok_live = not smt_candle_check or (close > open)
        if bear0 and bear_ok_live and array.size(arr_h_t) > 0
            ln_bear0 := line.new(array.get(arr_h_t,0), array.get(arr_h,0), time, hmax, xloc = xloc.bar_time, extend=extend.none, color=smt_bear_color, width=smt_line_width, style=lstyle)
        if bull0 and bull_ok_live and array.size(arr_l_t) > 0
            ln_bull0 := line.new(array.get(arr_l_t,0), array.get(arr_l,0), time, lmin, xloc = xloc.bar_time, extend=extend.none, color=smt_bull_color, width=smt_line_width, style=lstyle)

if array.size(arr_hm) > 1 and array.size(arr_chm) > 1 and tf_ok_mic
    [bear1m,bear0m,bull1m,bull0m] = f_ssmt(array.get(arr_hm,1),array.get(arr_hm,0),hmaxm,array.get(arr_lm,1),array.get(arr_lm,0),lminm,
     array.get(arr_chm,1),array.get(arr_chm,0),chmaxm,array.get(arr_clm,1),array.get(arr_clm,0),clminm,array.get(arrstart,0),show_candlesmic)//
    ssmt_label := bear1m ? ssmt_label + "Prev. Micro Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull1m ? ssmt_label + "Prev. Micro Cycles Bullish SSMT" + '\n' : ssmt_label
    ssmt_label := bear0m ? ssmt_label + "Live Micro Cycles Bearish SSMT" + '\n' : ssmt_label
    ssmt_label := bull0m ? ssmt_label + "Live Micro Cycles Bullish SSMT" + '\n' : ssmt_label
    array.set(m_SSMT,0,bear1m)
    array.set(m_SSMT,1,bear0m)    
    array.set(m_SSMT,2,bull1m)
    array.set(m_SSMT,3,bull0m)
f_psp_tpd(_htf,ok)=>
    if timeframe.in_seconds(tf) <= timeframe.in_seconds(_htf)//m-> main, o-> other
        var lblbull = label.new(na,na)
        var lblbear = label.new(na,na)
        [mh2,ml2,mc2,mo2,mt2,mh1,ml1,mc1,mo1,mt1,mh0,ml0,mc0,mo0,mt0,mup1,mdw1,ml1t,mh1t]=f_live_sym(close,open,high,low,time,_htf)
        [oh2,ol2,oc2,oo2,ot2,oh1,ol1,oc1,oo1,ot1,oh0,ol0,oc0,oo0,ot0,oup1,odw1,ol1t,oh1t]=f_live_sym(xc0,xo0,xh0,xl0,xt0,_htf)                 
        ups = array.from(mup1,oup1)
        dws = array.from(mdw1,odw1)

        lws0 = array.from(ml2,ml1,ml0) 
        lws1 = array.from(ol2,ol1,ol0)
        con_lws0 = array.min(lws0) == ml1
        con_lws1 = array.min(lws1) == ol1
   
        con_lowx = array.from(con_lws0, con_lws1)
        con_low  = array.some(con_lowx)

        hgh0 = array.from(mh2,mh1,mh0) 
        hgh1 = array.from(oh2,oh1,oh0)

        con_hgh0 = array.max(hgh0) == mh1
        con_hgh1 = array.max(hgh1) == oh1

        con_hghx = array.from(con_hgh0, con_hgh1)
        con_hgh  = array.some(con_hghx)

        arr_tpd = array.from(mc2 > mo0 , oc2 > oo0)
        tpd     = not array.every(arr_tpd) and array.some(arr_tpd)

        psp = not array.every(ups) and not array.every(dws)

        bear_tpd = psp and con_hgh and tpd
        bull_tpd = psp and con_low and tpd
        if bear_tpd and ok > 0
            lblbear := label.new(mh1t, mh1,text=f_text(_htf)+ '\n' +"🚦", xloc=xloc.bar_time,yloc=yloc.abovebar,color=color.new(color.gray,100),size= i_font,textcolor = color.navy)
            label.delete(lblbear[1])
        if bull_tpd and ok > 0
            lblbull := label.new(ml1t, ml1,text="🚦"+ '\n'+ f_text(_htf) , xloc=xloc.bar_time,yloc=yloc.belowbar,color=color.new(color.gray,100),size= i_font,textcolor = color.navy)
            label.delete(lblbull[1])
        [psp , bull_tpd,bear_tpd]
// ⚖ ,🚦

ssmt_label := ssmt_label + dot_line + '\n'
ssmt_label := ssmt_label + " PSP & TPD " + '\n' 
ssmt_label := ssmt_label + dot_line + '\n'
TF1_TPD=array.from(false,false)
TF2_TPD=array.from(false,false)
TF3_TPD=array.from(false,false)

if tf1ok and timeframe.in_seconds(tf) <= timeframe.in_seconds(tf1)
    [tf1_psp,tf1_bull_tpd,tf1_bear_tpd] = f_psp_tpd(tf1,1) 
    ssmt_label := tf1_bear_tpd ? ssmt_label + f_text(tf1)+ " Bearish TPD🚦 " + '\n' : ssmt_label
    ssmt_label := tf1_bull_tpd ? ssmt_label + f_text(tf1)+ " Bullish TPD🚦 " + '\n' : ssmt_label    
    array.set(TF1_TPD,0,tf1_bull_tpd)
    array.set(TF1_TPD,1,tf1_bear_tpd)

if tf2ok and timeframe.in_seconds(tf) <= timeframe.in_seconds(tf2)
    [tf2_psp,tf2_bull_tpd,tf2_bear_tpd] = f_psp_tpd(tf2,1)
    ssmt_label := tf2_bear_tpd ? ssmt_label + f_text(tf2)+  " Bearish TPD🚦 " + '\n' : ssmt_label
    ssmt_label := tf2_bull_tpd ? ssmt_label + f_text(tf2)+  " Bullish TPD🚦 " + '\n' : ssmt_label 
    array.set(TF2_TPD,0,tf2_bull_tpd)
    array.set(TF2_TPD,1,tf2_bear_tpd)       
if tf3ok and timeframe.in_seconds(tf) <= timeframe.in_seconds(tf3)
    [tf3_psp,tf3_bull_tpd,tf3_bear_tpd] = f_psp_tpd(tf3,1)
    ssmt_label := tf3_bear_tpd ? ssmt_label + f_text(tf3)+ " Bearish TPD🚦 " + '\n' : ssmt_label
    ssmt_label := tf3_bull_tpd ? ssmt_label + f_text(tf3)+ " Bullish TPD🚦 " + '\n' : ssmt_label
    array.set(TF3_TPD,0,tf3_bull_tpd)
    array.set(TF3_TPD,1,tf3_bear_tpd)
if tf0ok 
    [tf0_psp,tf0_bull_tpd,tf0_bear_tpd] = f_psp_tpd(tf,0) 
    if tf0_bull_tpd and (low[1] == lmin or low[1] == lminD or low[1] == lminW) and low > low[1]
        lb0bull = label.new(time[1], low[1],text="X" , xloc=xloc.bar_time,yloc=yloc.belowbar,color=color.new(color.gray,100),size= size.tiny,textcolor = bull_clr)
    if tf0_bear_tpd and (high[1] == hmax or high[1] == hmaxD or high[1] == hmaxW) and high < high[1]
        lb0bear = label.new(time[1], low[1],text="X" , xloc=xloc.bar_time,yloc=yloc.abovebar,color=color.new(color.gray,100),size= size.tiny,textcolor = bear_clr)
///////////////////////////////////////////////////////////////Alerts
f_alert(a_con1,a_con2,a_con3,number)=>
    var bull_alert_trigger = false
    var bear_alert_trigger = false

    bull_control_con1 =
     a_con1 == Wbu ? array.get(W_SSMT,3) : 
     a_con1 == Dbu ? array.get(D_SSMT,3) : 
     a_con1 == Nbu ? array.get(N_SSMT,3) :
     a_con1 == mbu ? array.get(m_SSMT,3) :
     a_con1 == "none" ? true : false   
    bear_control_con1 =
     a_con1 == Wbe ? array.get(W_SSMT,1) : 
     a_con1 == Dbe ? array.get(D_SSMT,1) : 
     a_con1 == Nbe ? array.get(N_SSMT,1) :
     a_con1 == mbe ? array.get(m_SSMT,1) :
     a_con1 == "none" ? true : false 

    bull_control_con2 =
     a_con2 == tf1bu ? array.get(TF1_TPD,0) : 
     a_con2 == tf2bu ? array.get(TF2_TPD,0) : 
     a_con2 == tf3bu ? array.get(TF3_TPD,0) :
     a_con2 == "none"  ? true : false   
 
    bear_control_con2 =
     a_con2 == tf1be ? array.get(TF1_TPD,1) : 
     a_con2 == tf2be ? array.get(TF2_TPD,1) : 
     a_con2 == tf3be ? array.get(TF3_TPD,1) :
     a_con2 == "none"  ? true : false 

    bull_control_con3 =
     a_con3 == Dbu ? array.get(D_SSMT,3) : 
     a_con3 == Nbu ? array.get(N_SSMT,3) :
     a_con3 == mbu  ? array.get(m_SSMT,3) :
     a_con3 == "none" ? true : false   
    bear_control_con3 =
     a_con3 == Dbe  ? array.get(D_SSMT,1) : 
     a_con3 == Nbe  ? array.get(N_SSMT,1) :
     a_con3 == mbe  ? array.get(m_SSMT,1) :
     a_con3 == "none" ? true : false

    bull_alert = bull_control_con1 and bull_control_con2 and bull_control_con3 and not (a_con1 == "none" and a_con2 == "none" and a_con3 == "none") 
    if bull_alert and bull_alert_trigger == false
        alert(number+" Bullish Selection Active ",alert.freq_once_per_bar_close)
        bull_alert_trigger := true
    bear_alert = bear_control_con1 and bear_control_con2 and bear_control_con3 and not (a_con1 == "none" and a_con2 == "none" and a_con3 == "none") 
    if bear_alert and bear_alert_trigger == false
        alert(number+" Bearish Selection Active ",alert.freq_once_per_bar_close)
    bear_alert_trigger := true
    ssmt_lbl  = dot_line + '\n'
    ssmt_lbl := ssmt_lbl + " Alerts " + '\n' 
    ssmt_lbl := ssmt_lbl + dot_line + '\n'        
    ssmt_lbl := bull_alert ? ssmt_lbl + number+ " Bullish Selection Active "  + '\n' : ssmt_lbl    
    ssmt_lbl := bear_alert ? ssmt_lbl + number+ " Bearish Selection Active "  + '\n' : ssmt_lbl 

    if bull_alert[1] and bull_alert == false
        bull_alert_trigger := false
    if bear_alert[1] and bear_alert == false
        bear_alert_trigger := false 
    if show_table
        table.cell(tablo,0,2,text=str.tostring(ssmt_lbl) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font)
 
///////////////////////////////////////////////////////////////////potantial AMD analysis
if amd_pot and show_table
    ssmt_label := ssmt_label + dot_line + '\n'
    ssmt_label := ssmt_label + " Potantial AMD " + '\n' 
    ssmt_label := ssmt_label + dot_line + '\n'
    if array.size(arr_hW) > 0 and val_sesW == val_sesW[1] 
        bear_amdW = hmaxW > array.get(arr_hW,0) and (txt0W == "M" or txt0W == "D") and close[1] < array.get(arr_hW,0)  and tf_okW
        ssmt_label := amd_pot and bear_amdW ? ssmt_label + "Weekly Bearish AMD "  + '\n' : ssmt_label 
        bull_amdW = lminW < array.get(arr_lW,0) and (txt0W == "M" or txt0W == "D") and close[1] > array.get(arr_lW,0)  and tf_okW
        ssmt_label := amd_pot and bull_amdW ? ssmt_label + "Weekly Bullish AMD "  + '\n' : ssmt_label 
    if array.size(arr_hD) > 0 and val_sesD == val_sesD[1]
        bear_amdD = hmaxD > array.get(arr_hD,0) and (txt0D == "M" or txt0D == "D") and close[1] < array.get(arr_hD,0)  and tf_okD
        ssmt_label := amd_pot and bear_amdD ? ssmt_label + "Daily Bearish AMD "  + '\n' : ssmt_label 
        bull_amdD = lminD < array.get(arr_lD,0) and (txt0D == "M" or txt0D == "D") and close[1] > array.get(arr_lD,0)  and tf_okD
        ssmt_label := amd_pot and bull_amdD ? ssmt_label + "Daily Bullish AMD "  + '\n' : ssmt_label 
    if array.size(arr_h) > 0 and val_ses == val_ses[1]
        bear_amd = hmax > array.get(arr_h,0) and (txt0 == "M" or txt0 == "D") and close[1] < array.get(arr_h,0)  and tf_ok
        ssmt_label := amd_pot and bear_amd ? ssmt_label + "90m Bearish AMD "  + '\n' : ssmt_label 
        bull_amd = lmin < array.get(arr_l,0) and (txt0 == "M" or txt0 == "D") and close[1] > array.get(arr_l,0)  and tf_ok
        ssmt_label := amd_pot and bull_amd ? ssmt_label + "90m Bullish AMD "  + '\n' : ssmt_label 
    if array.size(arr_hm) > 0 and not micro_tick
        bear_amdm = hmaxm > array.get(arr_hm,0) and (txt0m == "M" or txt0m == "D") and close[1] < array.get(arr_hm,0)  and tf_ok_mic
        ssmt_label := amd_pot and bear_amdm ? ssmt_label + "Micro Bearish AMD "  + '\n' : ssmt_label 
        bull_amdm = lminm < array.get(arr_lm,0) and (txt0m == "M" or txt0m == "D") and close[1] > array.get(arr_lm,0)  and tf_ok_mic
        ssmt_label := amd_pot and bull_amdm ? ssmt_label + "Micro Bullish AMD "  + '\n' : ssmt_label 

if al1ok
    f_alert(al_con1,al_con2,al_con3,"1")
if al2ok
    f_alert(bl_con1,bl_con2,bl_con3,"2")
if al3ok
    f_alert(cl_con1,cl_con2,cl_con3,"3")
if al4ok
    f_alert(dl_con1,dl_con2,dl_con3,"4")

if show_table
    table.cell(tablo,0,0,text="cd_Quarter cycles & SSMT &TPD_Cx",text_color=i_textcolor,bgcolor= i_main_clr, text_size = ii_font)
    table.cell(tablo,0,1,text=str.tostring(ssmt_label) ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font)

//////////////////True open plot
dt = timeframe.in_seconds(tf) * 1000
if newN and txt0 == "M" and txt0[1] == "A"
    TSO := o0
    TSOt:= time
if not (newN and txt0 == "M" and txt0[1] == "A")
    TSO  := TSO[1]
    TSOt := TSOt[1]
if tf_ok and show_TSO
    tso_line = box.new(left= TSOt , top = TSO, right = time+5*dt, bottom = TSO , xloc=xloc.bar_time, 
     border_color = topen_clr,bgcolor = color.new(color.red,100),text = "TSO", text_color = topen_clr,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
    box.delete(tso_line[1])

if newD and txt0D == "M" and txt0D[1] == "A"
    TDO := o0D
    TDOt:= time
if not (newD and txt0D == "M" and txt0D[1] == "A")
    TDO  := TDO[1]
    TDOt := TDOt[1]
if tf_okD and show_TDO
    tdo_line = box.new(left= TDOt , top = TDO, right = time+5*dt, bottom = TDO , xloc=xloc.bar_time, 
     border_color = topen_clr,bgcolor = color.new(color.red,100),text = "TDO", text_color = topen_clr,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
    box.delete(tdo_line[1])

if newW and txt0W == "M" and txt0W[1] == "A"
    TWO := o0W
    TWOt:= time
if not (newW and txt0W == "M" and txt0W[1] == "A")
    TWO  := TWO[1]
    TWOt := TWOt[1]
if tf_okW and show_TWO and not(tipo!="crypto")
    two_line = box.new(left= TWOt , top = TWO, right = time+5*dt, bottom = TWO , xloc=xloc.bar_time, 
     border_color = topen_clr,bgcolor = color.new(color.red,100),text = "TWO", text_color = topen_clr,text_valign = text.align_top,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
    box.delete(two_line[1])

newm := micro_tick
if micro_tick and txt0m == "M" and txt0m[1] == "A"
    TMSO  := o0m
    TMSOt := time
if not (micro_tick and txt0m == "M" and txt0m[1] == "A")
    TMSO  := TMSO[1]
    TMSOt := TMSOt[1]
if tf_ok_mic and show_TMSO
    tmo_line = box.new(left= TMSOt , top = TMSO, right = time+5*dt, bottom = TMSO , xloc=xloc.bar_time, 
     border_color = topen_clr,bgcolor = color.new(color.red,100),text = "TMSO", text_color = topen_clr,text_valign = text.align_bottom,text_halign = text.align_right,text_size = size.tiny,border_style = line.style_dotted)
    box.delete(tmo_line[1])

lbl2 =  dot_line + '\n'
lbl2 := lbl2 + "Cycles"+ '\n' 
lbl2 :=  lbl2 + dot_line + '\n'
lbl2 := tf_okW ? lbl2 + "W => " + txt0W + '\n' : lbl2
lbl2 := tf_okD ? lbl2 + "D => " + txt0D + '\n' : lbl2 
lbl2 := tf_ok  ? lbl2 + "90m => " + txt0 + '\n' : lbl2
lbl2 := tf_ok30 ? lbl2 + "30m => " + txt030 + '\n' : lbl2
lbl2 := tf_ok_mic ?lbl2 + "Mic. => " + txt0m  : lbl2

var tclr = color.white
var ttext =""
dtt = timeframe.in_seconds(tf)
var qt = time 
if timeframe.change(tf)
    qt := time
if barstate.isrealtime
    krmt = (time_close(tf) - timenow) /1000
    if  krmt > 3 * dtt/4
        tclr := q1_clr
        ttext :="A"
    else if krmt > dtt /2
        tclr := q2_clr
        ttext := "M"
    else if krmt > dtt /4
        tclr := q3_clr
        ttext := "D"
    else
        tclr := q4_clr
        ttext := "X"
last =str.tostring(txt0W) + "-" + str.tostring(txt0D) + "-"+str.tostring(txt0)+"-"+str.tostring(txt030)+"-"+str.tostring(txt0m)+"-"+ttext
if show_table
    table.cell(tablo,0,3,text= lbl2 ,text_color=i_textcolor,bgcolor= i_bgcolor, text_size = ii_font)
    table.cell(tablo,0,4,text= "Current Bar :" + ttext ,text_color=i_textcolor,bgcolor= tclr, text_size = ii_font)

