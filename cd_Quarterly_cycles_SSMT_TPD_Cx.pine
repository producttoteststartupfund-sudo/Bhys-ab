tf_okD     = timeframe.in_seconds(tf) <= timeframe.in_seconds("180")
tf_okW     = timeframe.in_seconds(tf) <= timeframe.in_seconds("1D")
var tablo = table.new(position = i_pos,columns = 2,rows = 11,frame_color=color.teal ,frame_width=2,border_color=i_bgcolor ,border_width=1)
var arr_h = array.new_float()
var arr_l = array.new_float()
var arr_o = array.new_float()
var arr_c = array.new_float()
var arr_t = array.new_string()

